{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Video Avatar Benchmark Candidate Registry",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "repo_url",
          "paper_url",
          "project_url",
          "license",
          "weights_status",
          "weights_source",
          "training_code_status",
          "inference_code_status",
          "input_modes",
          "output_modes",
          "adapter",
          "status",
          "claimed_runtime",
          "install_risk",
          "sample_command_known",
          "custom_input_readiness",
          "known_setup_risks",
          "redistribution_note",
          "commercial_caution",
          "remaining_check_required",
          "license_caution",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "repo_url": { "type": "string" },
          "project_url": { "type": "string" },
          "paper_url": { "type": "string" },
          "license": { "type": "string" },
          "weights_status": { "type": "string" },
          "weights_source": { "type": "string" },
          "training_code_status": { "type": "string" },
          "inference_code_status": { "type": "string" },
          "input_modes": { "type": "array", "items": { "type": "string" } },
          "output_modes": { "type": "array", "items": { "type": "string" } },
          "adapter": { "type": "string" },
          "status": { "type": "string" },
          "claimed_runtime": { "type": "string" },
          "install_risk": { "type": "string" },
          "sample_command_known": { "type": "string" },
          "custom_input_readiness": { "type": "string" },
          "known_setup_risks": { "type": "string" },
          "redistribution_note": { "type": "string" },
          "commercial_caution": { "type": "string" },
          "remaining_check_required": { "type": "string" },
          "license_caution": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
